{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Quota Glance",
  "version": "0.1.9",
  "identifier": "cn.akitten.codexQuotaGlance",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "capsule",
        "title": "Codex Quota Glance",
        "url": "index.html?desktop=1",
        "width": 620,
        "height": 72,
        "minWidth": 300,
        "minHeight": 56,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "backgroundColor": "#00000000",
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../electron/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
