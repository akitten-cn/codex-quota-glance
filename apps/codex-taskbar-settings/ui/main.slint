// 官方登录专用的按需设置窗口。
//
// 不使用系统主题的 Button / ComboBox / CheckBox：它们会随 Windows 高对比度或
// 旧主题切换到浅色底配浅色字。所有可见颜色在本文件中明确指定，保证可读性。
import { ScrollView } from "std-widgets.slint";

component NavButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked;
    height: 46px; border-radius: 12px;
    background: root.selected ? #1e3154 : #101827;
    border-width: 1px; border-color: root.selected ? #36d8d1 : #24334e;
    Text { x: 13px; width: parent.width - 26px; height: parent.height; text: root.text; color: root.selected ? #f2f6ff : #c4ccdd; font-size: 14px; font-weight: root.selected ? 650 : 500; vertical-alignment: center; }
    TouchArea { clicked => { root.clicked(); } }
}

component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked;
    height: 38px; min-width: 74px; border-radius: 9px;
    background: !root.enabled ? #20283a : root.primary ? #256d86 : #18243a;
    border-width: 1px; border-color: root.primary ? #4ee7dd : #38527a;
    Text { width: parent.width; height: parent.height; text: root.text; color: root.enabled ? #f7f9ff : #8a94a8; font-size: 14px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
    TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

component DarkInput inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    height: 44px; border-radius: 11px; background: #080f20;
    border-width: 1px; border-color: input.has-focus ? #47dfd8 : #31496e;
    Text { visible: root.text == "" && !input.has-focus; x: 13px; width: parent.width - 26px; height: parent.height; text: root.placeholder; color: #748096; font-size: 14px; vertical-alignment: center; }
    input := TextInput { x: 13px; width: parent.width - 26px; height: parent.height; text <=> root.text; color: #eef3ff; font-size: 14px; vertical-alignment: center; selection-background-color: #4b6fc9; selection-foreground-color: #ffffff; }
}

component CycleSelect inherits Rectangle {
    in-out property <int> current-index;
    in property <[string]> options;
    height: 44px; border-radius: 11px; background: #080f20;
    border-width: 1px; border-color: touch.has-hover ? #47dfd8 : #31496e;
    Text { x: 13px; width: parent.width - 44px; height: parent.height; text: root.options[root.current-index]; color: #eef3ff; font-size: 14px; vertical-alignment: center; }
    Text { x: parent.width - 28px; width: 18px; height: parent.height; text: "⌄"; color: #aeb9cc; font-size: 18px; vertical-alignment: center; }
    touch := TouchArea { clicked => { root.current-index = Math.mod(root.current-index + 1, root.options.length); } }
}

component ToggleRow inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    height: 44px; border-radius: 11px; background: #0d172a;
    border-width: 1px; border-color: touch.has-hover ? #3c7792 : #283d61;
    Text { x: 14px; width: parent.width - 72px; height: parent.height; text: root.text; color: #e6ebf7; font-size: 14px; vertical-alignment: center; }
    Rectangle { x: parent.width - 52px; y: (parent.height - 22px) / 2; width: 38px; height: 22px; border-radius: 11px; background: root.checked ? #2aaeb2 : #34435d; Rectangle { x: root.checked ? 18px : 3px; y: 3px; width: 16px; height: 16px; border-radius: 8px; background: #f5f8ff; } }
    touch := TouchArea { clicked => { root.checked = !root.checked; } }
}

export component SettingsWindow inherits Window {
    title: "Codex Taskbar 设置";
    width: 1060px; height: 720px; background: #071022;
    // Slint 的 software renderer 在部分中文 Windows 环境不能可靠选择 CJK
    // fallback。显式使用系统自带的 UI 字体，避免标签、按钮中文绘制为空白。
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 14px;
    in-out property<int> current-page: 0;
    in-out property<string> monitor-name;
    in-out property<string> width-text;
    in-out property<string> spacing-text;
    in-out property<string> offset-text;
    in-out property<string> cli-path;
    in-out property<int> anchor-index: 1;
    in-out property<int> log-level-index: 3;
    in-out property<bool> reduce-motion;
    in-out property<int> background-opacity-index: 3;
    in-out property<bool> show-lamp;
    in-out property<bool> show-rings;
    in-out property<bool> show-reset;
    in-out property<bool> show-today;
    in-out property<bool> show-cache;
    in-out property<int> lamp-order: 0;
    in-out property<int> rings-order: 1;
    in-out property<int> reset-order: 2;
    in-out property<int> today-order: 3;
    in-out property<int> cache-order: 4;
    in-out property<string> status-message: "就绪";
    in-out property<bool> save-enabled: true;
    callback save(); callback reset(); callback close-window();

    Rectangle {
        background: #071022;
        HorizontalLayout {
            spacing: 0px;
            Rectangle {
                width: 240px; background: #0b162b; border-color: #233a60; border-width: 1px;
                VerticalLayout {
                    padding: 20px; spacing: 10px;
                    Text { text: "CODEX TASKBAR"; color: #58dcd7; font-size: 11px; font-weight: 700; }
                    Text { text: "设置"; color: #f3f6ff; font-size: 27px; font-weight: 700; }
                    Text { text: "官方登录 · 叠浪监控"; color: #8ea4c6; font-size: 12px; }
                    Rectangle { height: 18px; }
                    NavButton { text: "任务栏布局"; selected: root.current-page == 0; clicked => { root.current-page = 0; } }
                    NavButton { text: "显示内容"; selected: root.current-page == 1; clicked => { root.current-page = 1; } }
                    NavButton { text: "诊断与关于"; selected: root.current-page == 2; clicked => { root.current-page = 2; } }
                    Rectangle { vertical-stretch: 1; }
                    Text { text: "设置仅在打开时运行，不影响任务栏常驻资源。"; color: #7d9abd; font-size: 12px; wrap: word-wrap; }
                }
            }
            Rectangle {
                horizontal-stretch: 1; background: #071022;
                VerticalLayout {
                    padding: 28px; spacing: 14px;
                    Text { text: root.current-page == 0 ? "任务栏布局" : root.current-page == 1 ? "显示内容" : "诊断与关于"; color: #f4f7ff; font-size: 27px; font-weight: 700; }
                    Text { text: root.current-page == 0 ? "默认优先启动在副屏；左右停靠会主动避开通知区和 TrafficMonitor。" : root.current-page == 1 ? "统一控制叠浪胶囊内的官方额度、今日消耗和缓存命中率。" : "调整日志与 Codex CLI 自动探测。"; color: #aeb8cd; font-size: 14px; }
                    ScrollView {
                        vertical-stretch: 1;
                        viewport := VerticalLayout {
                            spacing: 14px;
                            if root.current-page == 0 : Rectangle {
                                background: #0c172b; border-radius: 16px; border-color: #29446f; border-width: 1px;
                                VerticalLayout {
                                    padding: 20px; spacing: 11px;
                                    Text { text: "位置与空间"; color: #f2f6ff; font-size: 18px; font-weight: 600; }
                                    Text { text: "目标显示器设备名（留空时优先使用副屏）"; color: #adb8cc; font-size: 13px; }
                                    DarkInput { text <=> root.monitor-name; placeholder: "自动选择副屏"; }
                                    Text { text: "停靠位置（点击切换）"; color: #adb8cc; font-size: 13px; }
                                    CycleSelect { current-index <=> root.anchor-index; options: ["靠左", "靠右（避开通知区）"]; }
                                    Text { text: "任务栏宽度（px）"; color: #adb8cc; font-size: 13px; }
                                    DarkInput { text <=> root.width-text; placeholder: "320"; }
                                    Text { text: "安全间距 / TrafficMonitor 偏移（px）"; color: #adb8cc; font-size: 13px; }
                                    HorizontalLayout { spacing: 12px; DarkInput { text <=> root.spacing-text; placeholder: "8"; horizontal-stretch: 1; } DarkInput { text <=> root.offset-text; placeholder: "0"; horizontal-stretch: 1; } }
                                }
                            }
                            if root.current-page == 1 : Rectangle {
                                background: #0c172b; border-radius: 16px; border-color: #29446f; border-width: 1px;
                                VerticalLayout {
                                    padding: 22px; spacing: 12px;
                                    Text { text: "叠浪胶囊"; color: #f2f6ff; font-size: 19px; font-weight: 650; }
                                    Text { text: "紫色底浪代表 5 小时额度；青色前景浪代表 Weekly，颜色和流速映射 Codex 活动状态。"; color: #a9b9d1; font-size: 13px; wrap: word-wrap; }
                                    ToggleRow { text: "显示官方双层额度叠浪"; checked <=> root.show-rings; }
                                    ToggleRow { text: "在叠浪内显示今日消耗"; checked <=> root.show-today; }
                                    ToggleRow { text: "在叠浪内显示缓存命中率"; checked <=> root.show-cache; }
                                    Text { text: "未消耗区玻璃透明度（点击切换）"; color: #adb8cc; font-size: 13px; }
                                    CycleSelect { current-index <=> root.background-opacity-index; options: ["40%（更通透）", "50%", "60%", "70%（默认）", "80%", "90%", "100%（不透明）"]; }
                                    ToggleRow { text: "减少海浪动画（降低动态效果）"; checked <=> root.reduce-motion; }
                                    Rectangle { height: 1px; background: #2a4268; }
                                    Text { text: "自动浮窗"; color: #f2f6ff; font-size: 16px; font-weight: 600; }
                                    Text { text: "仅在官方 Token 总量出现可信正向增量时自动出现约 4 秒；轮询、状态变化和 SQLite 后备数据不会触发。"; color: #8fa5c7; font-size: 13px; wrap: word-wrap; }
                                    Text { text: "额度与重置时间始终以详情卡为准；任务栏不会显示“未知状态”或当前任务 Token。"; color: #6edbd4; font-size: 13px; wrap: word-wrap; }
                                }
                            }
                            if root.current-page == 2 : Rectangle {
                                background: #0c172b; border-radius: 16px; border-color: #29446f; border-width: 1px;
                                VerticalLayout {
                                    padding: 20px; spacing: 12px;
                                    Text { text: "日志与探测"; color: #f2f6ff; font-size: 18px; font-weight: 600; }
                                    Text { text: "日志等级（点击切换）"; color: #adb8cc; font-size: 13px; }
                                    CycleSelect { current-index <=> root.log-level-index; options: ["关闭", "错误", "警告", "信息", "调试", "跟踪"]; }
                                    Text { text: "Codex CLI 路径（可选）"; color: #adb8cc; font-size: 13px; }
                                    DarkInput { text <=> root.cli-path; placeholder: "自动探测"; }
                                    Text { text: "仅支持官方登录；不会读取或保存 API Key、第三方余额或 New API 信息。"; color: #8491a9; font-size: 13px; wrap: word-wrap; }
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Text { text: root.status-message; color: #9db8ff; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; }
                        ActionButton { text: "恢复默认"; clicked => { root.reset(); } }
                        ActionButton { text: "关闭"; clicked => { root.close-window(); } }
                        ActionButton { text: "保存并应用"; primary: true; enabled: root.save-enabled; clicked => { root.save(); } }
                    }
                }
            }
        }
    }
}
